# Allowlist for docker/api.Dockerfile (BuildKit reads <Dockerfile>.dockerignore before the root one).
# Everything is excluded, then only what the API runs is let back in. AC-CTR-02 checks the result.
*
!web/package.json
!api/package.json
!api/pnpm-lock.yaml
!api/migrations/*.sql
!api/src/*.ts
# The shared contract (web/stub/). All of it reaches the build stage; the image gets only what the API
# loads at run time, listed by Node's loader (docker/api/import-graph.ts, DEV-p5-containers-05), so a new
# contract file cannot be forgotten here.
!web/stub/*.ts
!docker/api/import-graph.ts
# Never: tests and test helpers, even when they match a pattern above.
**/*.test.ts
api/src/testDb.ts
**/.env*
