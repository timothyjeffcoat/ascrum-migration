{
  "name": "ascrum-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:msw": "vite --mode msw",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "stub": "node stub/server.ts",
    "lint": "eslint --max-warnings 0 . ../api ../docker && prettier --check . ../api ../docker",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../docker/tsconfig.json",
    "test": "vitest run --project unit",
    "e2e": "pnpm build && pnpm build:pages && playwright test",
    "e2e:compose": "pnpm build:pages && E2E_BASE_URL=http://localhost:${WEB_PORT:-55430} E2E_API_URL=http://localhost:${API_PORT:-55431} E2E_PROD_WEB_URL=http://localhost:${PROD_WEB_PORT:-55432} E2E_PROD_API_URL=http://localhost:${PROD_API_PORT:-55433} playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm e2e",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
